#!/bin/sh
SYSFS_ROOT="${ARTHUR_SYSFS_ROOT:-/sys/class/net}"

port_json() {
    local device="$1" label="$2" present=false link=false speed=null duplex=unknown
    local carrier current_speed current_duplex details
    if [ -n "$device" ] && [ -d "$SYSFS_ROOT/$device" ]; then
        present=true
        carrier="$(cat "$SYSFS_ROOT/$device/carrier" 2>/dev/null)"
        current_speed="$(cat "$SYSFS_ROOT/$device/speed" 2>/dev/null)"
        current_duplex="$(cat "$SYSFS_ROOT/$device/duplex" 2>/dev/null)"
        case "$carrier:$current_speed" in
            0:*) ;;
            1:[0-9]*) ;;
            *)
                details="$(ethtool "$device" 2>/dev/null)"
                [ -n "$carrier" ] || carrier="$(printf '%s\n' "$details" | awk '/Link detected:/ {print ($3 == "yes" ? 1 : 0)}')"
                current_speed="$(printf '%s\n' "$details" | sed -n 's/^[[:space:]]*Speed: \([0-9][0-9]*\)Mb\/s.*$/\1/p')"
                current_duplex="$(printf '%s\n' "$details" | awk '/Duplex:/ {print tolower($2)}')"
                ;;
        esac
        if [ "$carrier" = 1 ]; then
            link=true
            case "$current_speed" in ''|*[!0-9]*) ;; *)
                [ "$current_speed" -le 0 ] || speed="$current_speed"
                ;;
            esac
            case "$current_duplex" in full|half) duplex="$current_duplex" ;; esac
        fi
    fi
    printf '{"label":"%s","device":"%s","present":%s,"link":%s,"speed":%s,"duplex":"%s"}' \
        "$label" "$device" "$present" "$link" "$speed" "$duplex"
}

usb_path() {
    local path
    [ -n "$1" ] || return 1
    path="$(readlink -f "$SYSFS_ROOT/$1/device" 2>/dev/null)"
    [ -n "$path" ] || return 1
    while [ "$path" != / ] && [ -n "$path" ]; do
        if [ -r "$path/idVendor" ]; then
            printf '%s\n' "$path"
            return 0
        fi
        path="${path%/*}"
    done
    return 1
}

usb_bus_speed() {
    local path value
    path="$(usb_path "$1")" || { printf null; return; }
    value="$(cat "$path/speed" 2>/dev/null)"
    # Keep the USB endpoint's speed separate from any netdev-reported speed.
    printf '%s\n' "$value" | awk '
        /^[0-9]+([.][0-9]+)?$/ {if ($0 + 0 > 0) {printf "%g", $0; found=1}}
        END {if (!found) printf "null"}'
}

case "$1" in
    list) printf '{"status":{},"diagnose":{},"performance":{},"release_memory":{},"dashboard":{},"identity":{},"save_identity":{"hostname":"String","image":"String","reset":"Boolean"}}\n' ;;
    call)
        if [ "$2" = diagnose ]; then
            exec "${ARTHUR_HEALTH_SCRIPT:-/usr/libexec/arthur-health}"
        fi
        case "$2" in
            identity) exec /usr/libexec/arthur-identity status ;;
            save_identity) exec /usr/libexec/arthur-identity save ;;
            dashboard) exec "${ARTHUR_DASHBOARD_SCRIPT:-/usr/libexec/arthur-dashboard}" ;;
            performance) exec "${ARTHUR_PERF_SCRIPT:-/usr/libexec/arthur-performance}" status ;;
            release_memory) exec "${ARTHUR_PERF_SCRIPT:-/usr/libexec/arthur-performance}" release_memory ;;
        esac
        [ "$2" = status ] || exit 1
        enabled=true
        [ "$(uci -q get arthur.usb.enabled)" != 0 ] || enabled=false
        usb_device="$(uci -q get network.f50.device)"
        case "$usb_device" in *[!a-zA-Z0-9_.:-]*) usb_device='' ;; esac
        # Keep network.f50 as the internal interface ID for upgrade compatibility.
        if [ -z "$usb_device" ] || [ ! -d "$SYSFS_ROOT/$usb_device" ]; then
            usb_device=''
            for entry in "$SYSFS_ROOT"/*; do
                candidate="${entry##*/}"
                case "$candidate" in *[!a-zA-Z0-9_.:-]*) continue ;; esac
                path="$(usb_path "$candidate")" || continue
                driver="$(readlink -f "$SYSFS_ROOT/$candidate/device/driver" 2>/dev/null)"
                case "${driver##*/}" in cdc_ether|rndis_host|cdc_ncm) ;; *) continue ;; esac
                usb_device="$candidate"
                break
            done
        fi
        present=false
        [ -z "$usb_device" ] || [ ! -d "$SYSFS_ROOT/$usb_device" ] || present=true
        up=false
        [ "$(ubus call network.interface.f50 status 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null)" != true ] || up=true
        printf '{"ports":['
        port_json wan WAN
        printf ','; port_json lan1 LAN1
        printf ','; port_json lan2 LAN2
        printf ','; port_json lan3 LAN3
        printf '],"usb_enabled":%s,"usb_present":%s,"usb_up":%s,"usb_device":"%s","usb_port":' \
            "$enabled" "$present" "$up" "$usb_device"
        port_json "$usb_device" USB
        printf ',"usb_bus_speed":%s}\n' "$(usb_bus_speed "$usb_device")"
        ;;
    *) exit 1 ;;
esac
