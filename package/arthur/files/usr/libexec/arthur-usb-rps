#!/bin/sh
# Called by arthur-performance under its control lock. Status is read-only.
# RPS distributes receive processing; it never bypasses proxy/firewall rules.
export LC_ALL=C
NET="${ARTHUR_SYSFS_ROOT:-/sys/class/net}"
PROC="${ARTHUR_PROC_ROOT:-/proc}"
MODULES="${ARTHUR_MODULE_ROOT:-/sys/module}"
ECM="${ARTHUR_ECM_ROOT:-/sys/kernel/debug/ecm}"
STATE="${ARTHUR_PERF_STATE:-/var/run/arthur-performance}/usb-rps"

valid_name() {
    case "$1" in ''|.|..|*[!a-zA-Z0-9_.:-]*) return 1 ;; esac
}

read_mask() {
    local value
    value="$(cat "$1" 2>/dev/null | tr 'A-F' 'a-f')"
    case "$value" in ''|*[!0-9a-f,]*) return 1 ;; esac
    # sysfs may pad CPU masks with leading zeroes.
    value="$(printf '%s' "$value" | sed 's/^0*//')"
    printf '%s' "${value:-0}"
}

is_tether() {
    local path driver
    valid_name "$1" && [ -d "$NET/$1" ] || return 1
    path="$(readlink -f "$NET/$1/device" 2>/dev/null)"
    [ -n "$path" ] || return 1
    while [ "$path" != / ] && [ -n "$path" ]; do
        [ ! -r "$path/idVendor" ] || break
        path="${path%/*}"
    done
    [ -r "$path/idVendor" ] || return 1
    driver="$(readlink -f "$NET/$1/device/driver" 2>/dev/null)"
    case "${driver##*/}" in cdc_ether|rndis_host|cdc_ncm) return 0 ;; *) return 1 ;; esac
}

select_policy() {
    local entry candidate
    enabled=true
    [ "$(uci -q get arthur.performance.usb_rps)" != 0 ] || enabled=false
    device=''
    mask=''
    policy=off
    [ "$enabled" = true ] || return
    policy=usb_disabled
    [ "$(uci -q get arthur.usb.enabled)" != 0 ] || return
    # Do not fight netifd's global packet steering or a running NSS backend.
    policy=global_steering
    case "$(uci -q get network.globals.packet_steering)" in ''|0) ;; *) return ;; esac
    policy=nss
    if [ -d "$MODULES/ecm" ]; then
        [ "$(cat "$ECM/front_end_ipv4_stop" 2>/dev/null):$(cat "$ECM/front_end_ipv6_stop" 2>/dev/null)" = 1:1 ] || return
    fi
    policy=waiting
    candidate="$(uci -q get network.f50.device)"
    if is_tether "$candidate"; then
        device="$candidate"
    else
        for entry in "$NET"/*; do
            candidate="${entry##*/}"
            if is_tether "$candidate"; then device="$candidate"; break; fi
        done
    fi
    [ -n "$device" ] || return
    # Arthur's tested b mask: CPU0/1/3; leave CPU2 for the observed USB IRQ.
    # Only include online CPUs, as reported by /proc/stat.
    mask="$(awk '/^cpu[0-9]+ / {n=substr($1,4)+0; if(n==0)m+=1; if(n==1)m+=2; if(n==3)m+=8} END {printf "%x",m+0}' "$PROC/stat" 2>/dev/null)"
    policy=unsupported
    [ -n "$mask" ] && [ "$mask" != 0 ] || return
    for entry in "$NET/$device"/queues/rx-*/rps_cpus; do
        [ -f "$entry" ] || continue
        policy=ready
        break
    done
}

restore_device() {
    local dev="$1" saved node queue original applied current index failed=0
    valid_name "$dev" || return 1
    saved="$STATE/$dev"
    [ -d "$saved" ] || return 0
    index="$(cat "$NET/$dev/ifindex" 2>/dev/null)"
    # An interface name can be reused by a different USB device after unplugging.
    if [ -n "$index" ] && [ "$index" = "$(cat "$saved/ifindex" 2>/dev/null)" ]; then
        for node in "$saved"/rx-*.original; do
            [ -f "$node" ] || continue
            queue="${node##*/}"
            queue="${queue%.original}"
            valid_name "$queue" || continue
            original="$(read_mask "$node")" || continue
            applied="$(read_mask "$saved/$queue.applied")" || continue
            current="$(read_mask "$NET/$dev/queues/$queue/rps_cpus")" || continue
            # Preserve settings another administrator/service has since changed.
            if [ "$current" = "$applied" ] && [ "$current" != "$original" ]; then
                { printf '%s\n' "$original" >"$NET/$dev/queues/$queue/rps_cpus"; } 2>/dev/null || failed=1
            fi
        done
    fi
    [ "$failed" = 0 ] || return 1
    rm -f "$saved"/rx-*.original "$saved"/rx-*.applied "$saved/ifindex"
    rmdir "$saved" 2>/dev/null
    return 0
}

reconcile() {
    local entry dev saved index queue node previous current failed=0
    select_policy
    mkdir -p "$STATE" || return 1
    rm -f "$STATE/error"
    for entry in "$STATE"/*; do
        [ -d "$entry" ] || continue
        dev="${entry##*/}"
        if [ "$policy" != ready ] || [ "$dev" != "$device" ]; then
            restore_device "$dev" || failed=1
        fi
    done
    if [ "$failed" != 0 ]; then
        printf '%s\n' restore_failed >"$STATE/error"
        return 1
    fi
    [ "$policy" = ready ] || return 0
    saved="$STATE/$device"
    index="$(cat "$NET/$device/ifindex" 2>/dev/null)"
    case "$index" in ''|*[!0-9]*) printf '%s\n' unavailable >"$STATE/error"; return 1 ;; esac
    if [ -d "$saved" ] && [ "$index" != "$(cat "$saved/ifindex" 2>/dev/null)" ]; then
        restore_device "$device" || return 1
    fi
    mkdir -p "$saved" || return 1
    [ -f "$saved/ifindex" ] || printf '%s\n' "$index" >"$saved/ifindex"
    for node in "$NET/$device"/queues/rx-*/rps_cpus; do
        [ -f "$node" ] || continue
        queue="${node%/rps_cpus}"
        queue="${queue##*/}"
        valid_name "$queue" || continue
        previous="$(read_mask "$node")" || { failed=1; break; }
        if [ ! -f "$saved/$queue.original" ]; then
            printf '%s\n' "$previous" >"$saved/$queue.original" || { failed=1; break; }
        fi
        # Record ownership before writing so partial failures can be rolled back.
        printf '%s\n' "$mask" >"$saved/$queue.applied" || { failed=1; break; }
        if [ "$previous" != "$mask" ]; then
            { printf '%s\n' "$mask" >"$node"; } 2>/dev/null || { failed=1; break; }
        fi
        current="$(read_mask "$node")"
        [ "$current" = "$mask" ] || { failed=1; break; }
    done
    if [ "$failed" != 0 ]; then
        restore_device "$device" || :
        printf '%s\n' apply_failed >"$STATE/error"
        return 1
    fi
}

pause() {
    local entry failed=0
    [ -d "$STATE" ] || return 0
    for entry in "$STATE"/*; do
        [ -d "$entry" ] || continue
        restore_device "${entry##*/}" || failed=1
    done
    if [ "$failed" != 0 ]; then
        printf '%s\n' restore_failed >"$STATE/error"
        return 1
    fi
    rm -f "$STATE/error"
}

status() {
    local node queue current first=1 count=0 mismatch=0 queues='' error
    select_policy
    error="$(cat "$STATE/error" 2>/dev/null)"
    case "$error" in apply_failed|restore_failed|unavailable) ;; *) error='' ;; esac
    if [ -n "$device" ]; then
        for node in "$NET/$device"/queues/rx-*/rps_cpus; do
            [ -f "$node" ] || continue
            queue="${node%/rps_cpus}"
            queue="${queue##*/}"
            valid_name "$queue" || continue
            current="$(read_mask "$node")" || current=unknown
            [ "$current" = "$mask" ] || mismatch=1
            [ "$first" = 1 ] || queues="$queues,"
            queues="$queues{\"queue\":\"$queue\",\"mask\":\"$current\"}"
            first=0
            count=$((count + 1))
        done
    fi
    if [ "$policy" = ready ]; then
        policy=pending
        [ "$count" -gt 0 ] && [ "$mismatch" = 0 ] && policy=active
    fi
    [ -z "$error" ] || policy=error
    printf '{"enabled":%s,"state":"%s","device":"%s","target_mask":"%s","queues":[%s],"error":"%s"}' \
        "$enabled" "$policy" "$device" "$mask" "$queues" "$error"
}

case "$1" in
    reconcile) reconcile ;;
    pause) pause ;;
    status) status ;;
    *) exit 1 ;;
esac
