#!/bin/sh
# Run once after a clean installation. Root password is hashed during build.
uci -q batch <<'EOF'
set system.@system[0].hostname='jdy-cookorz'
set system.@system[0].zonename='Asia/Shanghai'
set system.@system[0].timezone='CST-8'
set luci.main.lang='zh_cn'
set luci.main.mediaurlbase='/luci-static/argon'
set network.lan.ipaddr='192.168.10.1'
set network.lan.netmask='255.255.255.0'
commit system
commit luci
commit network
EOF
if uci -q get upnpd.config >/dev/null; then
    uci -q set upnpd.config.enabled='0'
    uci -q commit upnpd
fi
exit 0
